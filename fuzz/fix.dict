# libFuzzer dictionary for FIX tag=value frames (-dict=fix.dict).

soh="\x01"
eq="="
neg="-"
fix40="8=FIX.4.0\x01"
fix42="8=FIX.4.2\x01"
fix44="8=FIX.4.4\x01"
fixt11="8=FIXT.1.1\x01"
appver="1128="
defappver="1137="
bodylength="\x019="
checksum="\x0110="
msgtype="\x0135="
seqnum="\x0134="
sender="\x0149="
target="\x0156="
sendingtime="\x0152="
possdup="43="
origtime="122="

# Data fields and their lengths: QuickFIX trusts the length (R-P0-13).
rawdatalen="95="
rawdata="96="
signaturelen="93="
signature="89="
securedatalen="90="
securedata="91="
xmldatalen="212="
xmldata="213="
encodedtextlen="354="
encodedtext="355="
encodedissuerlen="348="
encodedissuer="349="
encryptedpwdlen="1401="
encryptedpwd="1402="

# Repeating groups: count, then the first field of each entry.
nomdentries="268="
mdentrytype="269="
norelatedsym="146="
symbol="55="
nopartyids="453="
partyid="448="
nolegs="555="
legsymbol="600="
nomsgtypes="384="
refmsgtype="372="

# Values that move lengths and counts to their edges.
zero="0"
one="1"
big="100000"
huge="2000000000"
overflow="99999999999"
